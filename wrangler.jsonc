{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raidplan",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The public origin. Attached as a custom domain, so Cloudflare owns the DNS
  // record and the certificate; the workers.dev URL stays enabled alongside it.
  // APP_URL is deliberately unset — appUrl() then answers from the request
  // origin, so both hostnames build their own OAuth redirect_uri.
  "routes": [
    { "pattern": "raidplan.aure.onl", "custom_domain": true }
  ],
  // Wrangler turns workers.dev off whenever routes are set and this is absent.
  "workers_dev": true,

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else falls through to the SPA shell.
    "run_worker_first": ["/api/*", "/auth/*", "/backgrounds/*", "/mcp", "/mcp/*", "/sse", "/sse/*", "/agents/*"]
  },

  "kv_namespaces": [
    { "binding": "BACKGROUNDS", "id": "88d3b3462c5944c29c91ac46c81b8ca5" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "PlanAgent", "class_name": "PlanAgent" },
      { "name": "Registry", "class_name": "Registry" },
      { "name": "RaidPlanMCP", "class_name": "RaidPlanMCP" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlanAgent", "Registry", "RaidPlanMCP"] }
  ]

  // Configuration lives in .dev.vars locally and in secrets/vars in production:
  //   APP_URL, DISCORD_ALLOWLIST, DISCORD_GUILD_ID,
  //   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, SESSION_SECRET,
  //   GLM_API_KEY, GLM_BASE_URL, GLM_MODEL,
  //   FFLOGS_CLIENT_ID, FFLOGS_CLIENT_SECRET
  // (kept out of this file so they aren't baked into the typed Env as literals)
}
